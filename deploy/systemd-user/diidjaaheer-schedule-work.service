[Unit]
Description=Diidjaaheer schedule:work
After=network.target
ConditionPathExists=/home/deployer/diidjaaheer.live/current

[Service]
Type=simple
WorkingDirectory=/home/deployer/diidjaaheer.live/current
ExecStart=/usr/bin/php artisan schedule:work
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
